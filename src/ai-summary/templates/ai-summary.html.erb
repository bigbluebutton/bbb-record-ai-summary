<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= @title || "BigBlueButton Session — Summary & Transcript" %></title>
  <meta name="description" content="<%= @description || "Professional HTML5 summary for a BigBlueButton session with attendees, shared notes, transcript, and action items." %>" />
  <style>
    :root {
      --bg: #1a1b26;
      --panel: #24253a;
      --muted: #9aa5b4;
      --text: #fff;
      --accent: #82aaff;
      --ok: #9ece6a;
      --warn: #e0af68;
      --border: #2e3150;
      --shadow: 0 6px 18px rgba(0,0,0,.25);
      --radius: 16px;
    }
    /* Light theme: system preference (unless explicitly overridden to dark) */
    @media (prefers-color-scheme: light) {
      html:not([data-theme="dark"]) { --bg:#f1f4f9; --panel:#ffffff; --muted:#4b5563; --text:#0f172a; --accent:#2563eb; --ok:#16a34a; --warn:#b45309; --border:#d1d9e6; --shadow:0 8px 18px rgba(2,6,23,.08); }
    }
    /* Explicit theme overrides (set by toggle button, stored in localStorage) */
    [data-theme="light"] { --bg:#f1f4f9; --panel:#ffffff; --muted:#4b5563; --text:#0f172a; --accent:#2563eb; --ok:#16a34a; --warn:#b45309; --border:#d1d9e6; --shadow:0 8px 18px rgba(2,6,23,.08); }
    [data-theme="dark"] { --bg:#1a1b26; --panel:#24253a; --muted:#9aa5b4; --text:#e1e4ed; --accent:#82aaff; --ok:#9ece6a; --warn:#e0af68; --border:#2e3150; --shadow:0 6px 18px rgba(0,0,0,.25); }
    html, body { height: 100%; }
    body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, Inter, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji","Segoe UI Emoji"; }
    .container { max-width: 980px; margin: 0 auto; padding: 28px 18px 64px; }
    header.hero { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow); }
    .kpis { display:flex; gap:16px; flex-wrap:wrap; margin-top:16px; }
    .kpi { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 10px 14px; }
    .kpi .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing:.06em }
    .kpi .value { font-weight: 700; font-size: 20px; }
    nav.toc { margin: 22px 0 10px; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    nav.toc a { text-decoration: none; color: var(--accent); background: var(--panel); border: 1px solid var(--border); padding: 10px 12px; border-radius: 10px; }
    section { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; margin-top: 18px; box-shadow: var(--shadow); overflow-wrap: break-word; word-break: break-word; overflow: hidden; }
    section h2 { margin-top: 0; font-size: 20px; }
    section img, section iframe, section video { max-width: 100%; height: auto; }
    section a { word-break: break-all; color: var(--accent); }
    .muted { color: var(--muted); }
    .attendees { display:grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap:10px; list-style:none; padding:0; margin:0; }
    .attendees li { background: var(--bg); border: 1px solid var(--border); padding: 10px 12px; border-radius: 10px; }
    details.transcript { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    details.transcript[open] summary { border-bottom: 1px solid var(--border); }
    summary { list-style: none; cursor: pointer; padding: 14px 16px; font-weight: 600; background: var(--panel); }
    summary::-webkit-details-marker { display:none; }
    .cue { display: grid; grid-template-columns: 190px 1fr; gap: 12px; padding: 12px 16px; border-bottom: 1px dashed var(--border); }
    .cue:last-child { border-bottom: 0; }
    .cue time { font-variant-numeric: tabular-nums; color: var(--muted); }
    .speaker { font-weight: 600; margin-right: 6px; }
    .pill { display:inline-block; padding:2px 8px; border:1px solid var(--border); border-radius:999px; font-size:12px; background:var(--bg); }
    .ok { color: var(--ok); border-color: color-mix(in oklab, var(--ok) 40%, var(--border)); }
    .warn { color: var(--warn); border-color: color-mix(in oklab, var(--warn) 40%, var(--border)); }
    footer { color: var(--muted); text-align: center; margin: 28px 0 0; font-size: 14px; }
    .actions { display:flex; gap:10px; flex-wrap: wrap; }
    .btn { display:inline-flex; align-items:center; gap:8px; text-decoration:none; border:1px solid var(--border); background: var(--panel); padding:10px 12px; border-radius:10px; color: var(--text); cursor: pointer; }
    @media print { body { background:white; } .container { padding:0; } header.hero, section { box-shadow:none; } nav.toc, .actions { display:none; } }
    .discussion-item { display: grid; grid-template-columns: 110px 1fr; gap: 12px; padding: 10px 16px; border-bottom: 1px dashed var(--border); }
    .discussion-item:last-child { border-bottom: 0; }
    .discussion-item time { font-variant-numeric: tabular-nums; color: var(--muted); font-size: 13px; padding-top: 2px; }
    .discussion-item .speaker { font-weight: 600; margin-right: 6px; }
    .discussion-item.chat-msg { margin-left: 32px; background: var(--bg); border-radius: 8px; border-bottom: none; padding: 8px 14px; margin-top: 4px; margin-bottom: 4px; font-size: 14px; }
    .discussion-item.chat-msg .sender { font-weight: 600; margin-right: 4px; }
    .discussion-item.chat-msg .chat-icon { margin-right: 5px; opacity: .65; vertical-align: middle; }
  </style>
</head>
<body>
  <div class="container">
    <header class="hero" role="banner">
      <h1 style="margin:0 0 6px"><%= @title || "BigBlueButton Session — Summary" %></h1>
      <p class="muted" style="margin:0"><%= @subtitle || "A clean, printable HTML5 report with shared notes, attendees, transcript, and action items." %></p>
      <div class="kpis" role="group" aria-label="Quick stats">
        <div class="kpi"><div class="label">Attendees</div><div class="value"><%= (@attendees&.size || @attendee_count || 0) %></div></div>
        <div class="kpi"><div class="label">Transcript</div><div class="value"><%= @transcript_format || "Speaker‑labeled" %></div></div>
        <div class="kpi"><div class="label">Words</div><div class="value"><%= @word_count || 0 %></div></div>
      </div>
      <div class="actions" style="margin-top:12px">
        <button class="btn" id="printBtn" type="button" title="Print or save as PDF">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print
        </button>
        <button class="btn" id="themeBtn" type="button" title="Toggle light/dark theme">
          <!-- label set by JS on load -->
        </button>
        <button class="btn" id="collapseBtn" type="button" title="Collapse/expand transcript">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          Toggle transcript
        </button>
      </div>
    </header>

    <nav class="toc" aria-label="Contents">
      <% if @shared_notes && !@shared_notes.empty? %>
      <a href="#shared-notes">Shared Notes</a>
      <% end %>
      <a href="#attendees">Attendees</a>
      <% if @polls && !@polls.empty? %>
      <a href="#polls">Poll Results</a>
      <% end %>
      <% if @has_transcript || @has_chat %>
      <a href="#discussion">Transcript</a>
      <% end %>
      <% if @summary && !@summary.empty? %>
      <a href="#summary">Meeting Summary</a>
      <% end %>
      <% if @action_items && !@action_items.empty? %>
      <a href="#actions">Action Items</a>
      <% end %>
    </nav>

    <% if @shared_notes && !@shared_notes.empty? %>
    <section id="shared-notes" aria-labelledby="shared-notes-h">
      <h2 id="shared-notes-h">Shared Notes</h2>
      <%= @shared_notes %>
    </section>
    <% end %>

    <section id="attendees" aria-labelledby="attendees-h">
      <h2 id="attendees-h">Attendees <span class="pill"><%= (@attendees&.size || @attendee_count || 0) %></span></h2>
      <% if @attendees && !@attendees.empty? %>
        <ul class="attendees">
          <% @attendees.each do |name| %>
            <li><%= name %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">(No attendees recorded)</p>
      <% end %>
    </section>

    <% if @polls && !@polls.empty? %>
    <section id="polls" aria-labelledby="polls-h">
      <h2 id="polls-h">Poll Results <span class="pill"><%= @polls.length %></span></h2>
      <% @polls.each_with_index do |poll, idx| %>
        <h3 style="margin:.6em 0 .3em">Poll <%= idx + 1 %><% if poll[:question] && !poll[:question].empty? %>: <%= poll[:question] %><% end %></h3>
        <ul>
          <% (poll[:answers] || []).each do |answer| %>
            <li><strong><%= answer[:text] %></strong> — <%= answer[:votes] %> <%= answer[:votes] == 1 ? 'vote' : 'votes' %></li>
          <% end %>
        </ul>
      <% end %>
    </section>
    <% end %>

    <% if @has_transcript || @has_chat %>
    <section id="discussion" aria-labelledby="discussion-h">
      <h2 id="discussion-h">Transcript <span class="pill" id="timeline-count">0</span></h2>
      <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-bottom:12px;">
        <% if @has_chat %>
        <label style="display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:14px;cursor:pointer;">
          <input type="checkbox" id="show-chat" <%= @include_chat ? 'checked' : '' %> onchange="renderTimeline()" /> Show chat messages
        </label>
        <% end %>
        <% if @transcript_provider == 'openai_whisper' %>
        <label style="display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:14px;cursor:pointer;">
          <input type="checkbox" id="group-cues" checked onchange="renderTimeline()" /> Group cues
        </label>
        <% end %>
      </div>
      <details class="transcript" open>
        <summary>Expand / Collapse</summary>
        <div id="timeline-container"></div>
      </details>
      <p class="muted" style="margin-top:8px">Timestamps relative to recording start.</p>
    </section>
    <% end %>

    <% if @summary && !@summary.empty? %>
      <section id="summary" aria-labelledby="summary-h">
        <h2 id="summary-h">Meeting Summary</h2>
        <% if @summary_html && !@summary_html.empty? %>
          <%= @summary_html %>
        <% else %>
          <div style="white-space: pre-wrap;"><%= @summary %></div>
        <% end %>
      </section>
    <% end %>

    <% if @action_items && !@action_items.empty? %>
      <section id="actions" aria-labelledby="actions-h">
        <h2 id="actions-h">Action Items</h2>
        <ul>
          <% @action_items.each do |ai| %>
            <% klass = ai[:status] == :ok ? 'ok' : (ai[:status] == :warn ? 'warn' : '') %>
            <li><span class="pill <%= klass %>">Owner: <%= ai[:owner] %></span> <%= ai[:label] %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <footer>
      <p><%= @footer || "Generated by BigBlueButton Notes processor. Optimized for print and dark/light mode." %></p>
    </footer>
  </div>

  <script>
    // Theme toggle
    (function() {
      const html = document.documentElement;
      const btn = document.getElementById('themeBtn');

      function isDark() {
        const t = html.getAttribute('data-theme');
        return t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      }

      const SUN = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
      const MOON = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';

      function updateBtn() {
        if (btn) btn.innerHTML = isDark() ? `${SUN} Light mode` : `${MOON} Dark mode`;
      }

      const saved = localStorage.getItem('theme');
      if (saved) html.setAttribute('data-theme', saved);
      html.classList.toggle('dark', isDark());
      updateBtn();

      btn?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        html.classList.toggle('dark', next === 'dark');
        localStorage.setItem('theme', next);
        updateBtn();
      });
    })();

    // Print
    document.getElementById('printBtn')?.addEventListener('click', () => window.print());

    // Collapse transcript and discussion
    document.getElementById('collapseBtn')?.addEventListener('click', () => {
      document.querySelectorAll('details.transcript').forEach(d => { d.open = !d.open; });
    });

    // Timeline rendering
    (function() {
      const CUES    = <%= @transcript_cues_json || '[]' %>;
      const CHAT    = <%= @chat_messages_json || '[]' %>;
      const GAP_MS  = <%= @group_gap_ms || 5000 %>;

      function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      function fmtMs(ms) {
        ms = Math.max(0, ms);
        const h   = Math.floor(ms / 3600000);
        const m   = Math.floor((ms % 3600000) / 60000);
        const s   = Math.floor((ms % 60000) / 1000);
        const mil = ms % 1000;
        return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}.${String(mil).padStart(3,'0')}`;
      }

      function groupCues(cues, chatMsgs, gapMs) {
        if (!cues.length) return [];
        // Pre-sort chat timestamps for break-point detection
        const chatTs = chatMsgs.map(m => m.timestamp_ms).sort((a, b) => a - b);
        const groups = [];
        let cur = { start_ms: cues[0].start_ms, end_ms: cues[0].end_ms, speaker: cues[0].speaker, text: cues[0].text };
        for (let i = 1; i < cues.length; i++) {
          const c = cues[i];
          const sameSpeaker  = c.speaker === cur.speaker;
          const withinGap    = (c.start_ms - cur.end_ms) < gapMs;
          // Break if a chat message falls in the gap before this cue OR within this cue's time range
          const hasChatBreak = chatTs.some(ts => ts > cur.start_ms && ts <= c.start_ms);
          if (sameSpeaker && withinGap && !hasChatBreak) {
            cur.end_ms  = c.end_ms;
            cur.text   += ' ' + c.text;
          } else {
            groups.push(cur);
            cur = { start_ms: c.start_ms, end_ms: c.end_ms, speaker: c.speaker, text: c.text };
          }
        }
        groups.push(cur);
        return groups;
      }

      const CHAT_ICON = '<svg class="chat-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M6 18V15H5.5C4.67157 15 4 14.3284 4 13.5V6.5C4 5.67157 4.67157 5 5.5 5H18.5C19.3284 5 20 5.67157 20 6.5V13.5C20 14.3284 19.3284 15 18.5 15H10L6 18Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="12" cy="10" r="1" fill="currentColor"/><circle cx="15" cy="10" r="1" fill="currentColor"/></svg>';

      function renderTimeline() {
        const showChat = document.getElementById('show-chat')?.checked ?? false;
        const grouped  = document.getElementById('group-cues')?.checked ?? true;

        const transcriptItems = (grouped ? groupCues(CUES, showChat ? CHAT : [], GAP_MS) : CUES).map(c => ({
          type: 'transcript', timestamp_ms: c.start_ms, start_ms: c.start_ms,
          end_ms: c.end_ms, speaker: c.speaker, text: c.text
        }));

        const chatItems = showChat ? CHAT.map(m => ({ type: 'chat', ...m })) : [];

        const items = [...transcriptItems, ...chatItems].sort((a, b) => a.timestamp_ms - b.timestamp_ms);

        const html = items.map(item => {
          if (item.type === 'transcript') {
            return `<div class="discussion-item transcript-cue"><time>${fmtMs(item.start_ms)}</time><div><span class="speaker">${escHtml(item.speaker)}:</span> ${escHtml(item.text)}</div></div>`;
          } else {
            return `<div class="discussion-item chat-msg"><time>${fmtMs(item.timestamp_ms)}</time><div>${CHAT_ICON}<span class="sender">${escHtml(item.sender)} <span class="pill" style="font-size:10px;padding:1px 5px;">chat</span>:</span> ${escHtml(item.message)}</div></div>`;
          }
        }).join('');

        const container = document.getElementById('timeline-container');
        if (container) container.innerHTML = html;
        const countEl = document.getElementById('timeline-count');
        if (countEl) countEl.textContent = items.length;
      }

      window.renderTimeline = renderTimeline;
      renderTimeline();
    })();

    // Smooth scroll for TOC links
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', (e) => {
        const el = document.querySelector(a.getAttribute('href'));
        if (el) {
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', a.getAttribute('href'));
        }
      });
    });
  </script>
</body>
</html>
