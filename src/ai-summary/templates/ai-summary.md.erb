# <%= @strings["heading_shared_notes"] %>

<% if @notes_content && !@notes_content.empty? %>
<%= @notes_content %>
<% else %>
<%= @strings["no_notes"] %>
<% end %>

---

<% if @attendees && !@attendees.empty? %>
## <%= @strings["heading_attendees"] %> (<%= @attendees.length %>)

<%= @attendees.map { |name| "- #{name}" }.join("\n") %>

---

<% end %>
<% if @polls && !@polls.empty? %>
## <%= @strings["heading_poll_results"] %> (<%= @polls.length %>)

<% @polls.each_with_index do |poll, idx| %>
### <%= @strings["poll_prefix"] %> <%= idx + 1 %>: <%= poll[:question] %>

<% poll[:answers].each do |answer| %>
- **<%= answer[:text] %>**: <%= answer[:votes] %> <%= answer[:votes] == 1 ? @strings["vote_singular"] : @strings["vote_plural"] %>
<% end %>

<% end %>
---

<% end %>
<% if @discussion_timeline && !@discussion_timeline.empty? %>
## <%= @strings["heading_discussion"] %>

<% @discussion_timeline.each do |item| %>
<% if item[:type] == :transcript %>
**[<%= item[:display_time] %>] <%= item[:speaker] %>:** <%= item[:text] %>

<% elsif item[:type] == :chat %>
**[<%= item[:display_time] %>] <%= item[:sender] %> [<%= @strings["chat_tag"] %>]:** <%= item[:message] %>

<% end %>
<% end %>
---

<% elsif @transcript_diarized && !@transcript_diarized.empty? %>
## <%= @strings["heading_transcription_diarized"] %>

<% @transcript_diarized.each do |cue| %>
**[<%= cue[:start] %> → <%= cue[:end] %>] <%= cue[:speaker] %>:** <%= cue[:text] %>

<% end %>
---

<% elsif @transcript && !@transcript.empty? %>
## <%= @strings["heading_transcription"] %>

<%= @transcript %>

---

<% end %>
<% if @summary && !@summary.empty? %>
## <%= @strings["heading_summary"] %>

<%= @summary %>

---

<% end %>
<% if @word_count %>
*<%= @strings["word_count_label"] %> <%= @word_count %> <%= @strings["word_count_unit"] %>*
<% end %>
