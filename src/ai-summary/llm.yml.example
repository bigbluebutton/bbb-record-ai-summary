# LLM Configuration for Meeting Summarization
# Copy this file to llm.yml and configure your settings

# Provider selection: 'claude', 'openai', 'albert', or 'disabled'
# Set to 'disabled' to skip AI summarization
provider: 'disabled'

# API Keys
# Environment variables take priority over these values:
#   - ANTHROPIC_API_KEY for Claude
#   - OPENAI_API_KEY for OpenAI
#   - ALBERT_API_KEY for Albert (albert.api.etalab.gouv.fr)
# Leave blank to use environment variables only
anthropic_api_key: ''
openai_api_key: ''
albert_api_key: ''

# Claude (Anthropic) Configuration
claude:
  model: 'claude-3-5-sonnet-20241022'  # or 'claude-3-haiku-20240307' for faster/cheaper
  max_tokens: 1024
  temperature: 0.7

# OpenAI Configuration
openai:
  model: 'o4-mini'  # or 'gpt-4o' for better quality
  # max_tokens: 1024 # - o4-mini doesn't expect these parameters
  # temperature: 0.7 # - make sure the model chosen fits the parameters

# Albert Configuration (albert.api.etalab.gouv.fr — French government API)
albert:
  model: 'AgentPublic/llama3-instruct-8b'  # check available models at albert.api.etalab.gouv.fr
  max_tokens: 1024
  temperature: 0.7

# Force the summary output language (ISO 639-1 code, e.g. 'en', 'fr', 'es').
# Takes priority over the language detected from the transcription.
# When set, an instruction is appended to the system prompt overriding the language.
# When omitted, the system prompt below instructs the LLM to detect the language automatically.
# language: 'en'

# Include public chat messages in the Discussion section of the HTML report.
# When true, a "Discussion" tab is rendered that interleaves audio transcript cues
# and chat messages in chronological order — useful when participants answer in chat
# what was said in audio, or vice versa.
# Chat is always included in the LLM prompt for summary/action-item context regardless
# of this setting.
include_chat_in_discussion: false

# System prompt for summarization
system_prompt: |
  You are summarizing a BigBlueButton meeting. You will receive the shared notes
  and audio transcript from the meeting.

  Create a concise summary that includes:

  1. Main topics discussed
  2. Key decisions made
  3. Action items (if any)
  4. Important points raised

  Detect the language of the transcript and write the entire summary in that same language.
  Never translate or switch languages.

  Keep the summary clear, professional, and under 500 words.
