# Copy to docs.yml and fill in your values before deploying.

# Set to false to disable publishing to Docs entirely.
enabled: true

# Base URL of the Docs service
docs_host: https://docs.example.com

# Keycloak OIDC settings (client_credentials grant)
# First enable **Service Account Roles** in Keycloak client (under Clients -> Docs client -> Settings -> Capability config -> Authentication flow)
keycloak_host: id.example.com
realm: docs
client_id: docs
client_secret: CHANGE_ME_OIDC_CLIENT_SECRET


