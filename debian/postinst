#!/bin/bash -e

BIGBLUEBUTTON_USER=bigbluebutton
TRANSCRIPTION_DIR=/usr/local/bigbluebutton/core/lib/transcription
TEMPLATES_DIR=/usr/share/bbb-record-ai-summary

case "$1" in
  configure|upgrade|1|2)

    TARGET=/usr/local/bigbluebutton/core/scripts/ai-summary.yml

    chmod +r $TARGET

    mkdir -p /var/bigbluebutton/published/ai-summary
    chown -R $BIGBLUEBUTTON_USER:$BIGBLUEBUTTON_USER /var/bigbluebutton/published/ai-summary
    chmod -R o+rx /var/bigbluebutton/published/

    mkdir -p /var/log/bigbluebutton/ai-summary
    chown -R $BIGBLUEBUTTON_USER:$BIGBLUEBUTTON_USER /var/log/bigbluebutton/ai-summary

    mkdir -p /var/bigbluebutton/recording/publish/ai-summary
    chown -R $BIGBLUEBUTTON_USER:$BIGBLUEBUTTON_USER /var/bigbluebutton/recording/publish/ai-summary

    # Create transcription.yml if it doesn't already exist
    TRANSCRIPTION_CONF=${TRANSCRIPTION_DIR}/transcription.yml
    if [ ! -f "$TRANSCRIPTION_CONF" ]; then
      cp "$TEMPLATES_DIR/transcription.yml" "$TRANSCRIPTION_CONF"
      chown $BIGBLUEBUTTON_USER:$BIGBLUEBUTTON_USER "$TRANSCRIPTION_CONF"
      chmod 640 "$TRANSCRIPTION_CONF"
    fi

    # Install node-vad globally if npm is available (used by albert_whisper for VAD)
    if command -v npm &>/dev/null; then
      if ! npm list -g node-vad --depth=0 &>/dev/null 2>&1; then
        npm install -g node-vad --silent || echo "WARNING: node-vad installation failed — VAD will be disabled."
      fi
    else
      echo "NOTE: npm not found — install Node.js and run 'npm install -g node-vad' to enable VAD in albert_whisper."
    fi

    # Remove config templates now that they've been copied
    rm -rf "$TEMPLATES_DIR"

    systemctl reload nginx
  ;;

  failed-upgrade)
  ;;

  *)
    echo "## postinst called with unknown argument \`$1'" >&2
  ;;
esac
