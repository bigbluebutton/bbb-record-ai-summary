#!/usr/bin/make -f

%:
	dh $@ --no-parallel --verbose

override_dh_auto_build:
	# No compilation step — pure Ruby scripts

override_dh_auto_install:
	# Process and publish scripts
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/process
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/publish
	install -m 755 src/ai-summary/process/ai-summary.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/process/
	install -m 755 src/ai-summary/publish/ai-summary.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/publish/

	# Format config
	install -m 644 src/ai-summary/ai-summary.yml \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/

	# Post-archive transcription hook
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/post_archive
	install -m 755 src/scripts/post_archive/transcribe_audio.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/post_archive/

	# Transcription backends (active one selected via transcriber_path in transcription.yml)
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/lib/transcription
	install -m 644 src/scripts/transcription/transcription_utils.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/lib/transcription/transcription_utils.rb
	install -m 755 src/scripts/transcription/openai_whisper.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/lib/transcription/openai_whisper.rb
	install -m 755 src/scripts/transcription/albert_whisper.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/lib/transcription/albert_whisper.rb

	# LLM library
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/lib/ai-summary
	install -m 644 src/ai-summary/lib/llm_client.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/lib/ai-summary/

	# Config templates — stored out of the way; postinst copies them to their final location
	install -d debian/bbb-record-ai-summary/usr/share/bbb-record-ai-summary
	install -m 644 src/scripts/transcription/transcription.yml \
		debian/bbb-record-ai-summary/usr/share/bbb-record-ai-summary/

	# ERB templates
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary
	install -m 644 src/ai-summary/templates/ai-summary.md.erb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary/
	install -m 644 src/ai-summary/templates/ai-summary.html.erb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary/
	install -m 644 src/ai-summary/templates/ai-summary.json.erb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary/

	# Locale files
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary/locales
	install -m 644 src/ai-summary/templates/locales/en.json \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary/locales/
	install -m 644 src/ai-summary/templates/locales/pt.json \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary/locales/
	install -m 644 src/ai-summary/templates/locales/fr.json \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/playback/ai-summary/locales/

	# Post-publish hook
	install -d debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/post_publish
	install -m 755 src/scripts/post_publish/publish_to_docs.rb \
		debian/bbb-record-ai-summary/usr/local/bigbluebutton/core/scripts/post_publish/

	# Nginx location block
	install -d debian/bbb-record-ai-summary/usr/share/bigbluebutton/nginx
	install -m 644 ai-summary-playback.nginx \
		debian/bbb-record-ai-summary/usr/share/bigbluebutton/nginx/ai-summary.nginx

override_dh_usrlocal:
	# Intentionally install into /usr/local — skip dh_usrlocal
